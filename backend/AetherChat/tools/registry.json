    {
      "name": "write_artifact",
      "description": "写入当前会话工件。短内容用 overwrite；长文档必须把 content 拆成不超过 1200 个汉字的块，首块 overwrite/sequence=0，后续用 append 且 sequence 递增。",
      "category": "artifact",
      "owner": "system",
      "kind": "internal",
      "input_schema": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "overwrite",
              "append"
            ],
            "description": "默认 overwrite；长文档后续分块使用 append"
          },
          "sequence": {
            "type": "integer",
            "description": "分块序号；overwrite 为 0，append 从 1 递增"
          },
          "commit_message": {
            "type": "string"
          },
          "task_id": {
            "type": "string",
            "description": "可选：关联任务；成功后自动推进到 review"
          }
        }
      },
      "output_template": "工具 ${name} 已执行，输入：${input}",
      "enabled": true,
      "session_id": null,
      "id": "1c64b029-0979-58c3-96e1-db8be776e377",
      "created_at": "2026-07-15T04:15:17.646311+00:00",
      "updated_at": "2026-08-11T14:35:42.719130+00:00"
    },
