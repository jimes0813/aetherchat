# AetherChat Environment Variables
# Copy to .env and fill in your keys

# LLM API Keys (used via vault or direct)
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
QWEN_API_KEY=sk-...
KIMI_API_KEY=sk-...

# Optional: Redis for locks / sliding-window rate limits (desktop app does not need Postgres).
# REDIS_URL=redis://127.0.0.1:6379/0

# For local dev without docker
# VITE_API_BASE=http://localhost:8000
# Browser-only development must opt into the temporary in-memory token endpoint.
# Never enable this on a network-accessible or production backend.
# AETHERCHAT_ENABLE_DEMO_AUTH=1

# Standalone production backends must receive a random token from their launcher.
# The packaged Electron app creates this automatically; do not commit a real value.
# AETHERCHAT_API_TOKEN=
