#!/usr/bin/env bash
set -euo pipefail

readonly APP_DIR="/opt/AetherChat"
readonly APP="$APP_DIR/aetherchat-frontend"
readonly SANDBOX="$APP_DIR/chrome-sandbox"

fail() {
  local message="$1"
  local state_root="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}"
  local log_dir="$state_root/aetherchat"
  printf 'AetherChat: %s\n' "$message" >&2
  if mkdir -p "$log_dir" 2>/dev/null; then
    chmod 0700 "$log_dir" 2>/dev/null || true
    printf '%s AetherChat: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$message" \
      >> "$log_dir/launcher.log" 2>/dev/null || true
    chmod 0600 "$log_dir/launcher.log" 2>/dev/null || true
  fi
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title='AetherChat 启动失败' --text="$message" 2>/dev/null || true
    elif command -v kdialog >/dev/null 2>&1; then
      kdialog --error "$message" --title 'AetherChat 启动失败' 2>/dev/null || true
    elif command -v xmessage >/dev/null 2>&1; then
      xmessage -center "AetherChat 启动失败：$message" 2>/dev/null || true
    fi
  fi
  exit 1
}

[[ -x "$APP" ]] || fail "secure system installation is missing at $APP"
[[ -f "$SANDBOX" ]] || fail "Chromium sandbox is missing at $SANDBOX"

owner_uid="$(stat -c '%u' "$SANDBOX" 2>/dev/null)" || \
  fail "cannot inspect Chromium sandbox owner"
owner_gid="$(stat -c '%g' "$SANDBOX" 2>/dev/null)" || \
  fail "cannot inspect Chromium sandbox group"
mode="$(stat -c '%a' "$SANDBOX" 2>/dev/null)" || \
  fail "cannot inspect Chromium sandbox permissions"

if [[ "$owner_uid" != "0" || "$owner_gid" != "0" || "$mode" != "4755" ]]; then
  fail "unsafe Chromium sandbox metadata (expected root:root 4755, got ${owner_uid}:${owner_gid} ${mode}); reinstall the Debian package"
fi

# A stale SOCKS proxy breaks backend HTTP clients. Local API traffic must never
# leave the host, regardless of the user's proxy configuration.
unset ALL_PROXY all_proxy || true
export NO_PROXY="${NO_PROXY:+$NO_PROXY,}localhost,127.0.0.1,::1"
export no_proxy="${no_proxy:+$no_proxy,}localhost,127.0.0.1,::1"

exec "$APP" "$@"
