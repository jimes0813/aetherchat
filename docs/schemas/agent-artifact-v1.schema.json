{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherchat.local/schemas/agent-artifact-v1.schema.json",
  "title": "AetherChat Agent Artifact Exchange",
  "description": "Portable metadata envelope for an artifact produced by an Agent tool.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "artifact_type",
    "session_id",
    "producer",
    "engine",
    "operation",
    "submitted_at",
    "completed_at",
    "parameters",
    "provenance",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": "aetherchat.agent-artifact/v1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": ["agent", "plugin", "action"],
      "properties": {
        "agent": { "type": "string" },
        "plugin": { "type": "string" },
        "action": { "type": "string" }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "prompt_id": {
      "type": ["string", "null"]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "parameters": {
      "type": "object"
    },
    "workflow_name": {
      "type": ["string", "null"]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "node_map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "input"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "input": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "overridable_inputs": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["models", "seeds", "dimensions"],
      "properties": {
        "models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "seeds": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "node_name", "input", "value"],
            "properties": {
              "node_id": { "type": "string" },
              "node_name": { "type": "string" },
              "input": { "type": "string" },
              "value": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename"],
        "properties": {
          "filename": { "type": "string" },
          "kind": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
